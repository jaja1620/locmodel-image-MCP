  "hosts_source": "install/hosts.json",
  "verify": [
    {
      "id": "doctor",
      "kind": "command",
      "cwd": "install_root",
      "argv": [
        "{python}",
        "scripts/locmodel_image.py",
        "doctor"
      ],
      "expect": "prints a checklist (python, platform, config path, engine port, model, GPU); exit 0 means the basics are fine. A non-zero exit only about the engine means the bridge itself is installed correctly."
    },
    {
      "id": "mcp-handshake",
      "kind": "stdio-jsonrpc",
      "cwd": "install_root",
      "argv": [
        "{python}",
        "scripts/locmodel_mcp.py"
      ],
      "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"repo-install-check\",\"version\":\"1\"}}}\n",
      "expect_stdout_contains": "serverInfo",
      "note": "No --selftest flag exists; the server is a plain stdio loop, so verification is one initialize request piped in."
    }
  ]
